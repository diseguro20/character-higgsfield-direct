{
  "cleanUrls": false,
  "functions": {
    "api/index.js": { "maxDuration": 300 }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    }
  ]
}
