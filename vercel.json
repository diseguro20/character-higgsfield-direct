{
  "cleanUrls": false,
  "buildCommand": "node scripts/vercel-build.js",
  "functions": {
    "api/index.js": { "maxDuration": 300, "includeFiles": "vendor/**" }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    }
  ]
}
